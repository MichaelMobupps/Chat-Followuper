# Chat Followuper — environment variables (Phase 1)
# Copy to .env and fill values. Never commit real secrets.

# Database (provisioned automatically on Replit)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Session signing (already provisioned in Replit secrets)
SESSION_SECRET=replace-me-with-a-long-random-string

# Public base URL for OAuth redirects and webhook callbacks
PUBLIC_BASE_URL=https://example.replit.app

# Anthropic — LLM for outreach generation (Phase 2+)
ANTHROPIC_API_KEY=
# Optional per-user daily Anthropic spend cap in USD (LLM3). Unset / <=0 disables
# the cap; set a positive number to reject generation with 429 once a user's
# same-day spend reaches it. Example: LLM_DAILY_SPEND_CAP_USD=10
LLM_DAILY_SPEND_CAP_USD=

# Apollo — prospect enrichment (Phase 2+)
APOLLO_API_KEY=
# Per-user monthly Apollo reveal cap (APO1/API3). Default 100 when unset; a
# positive override changes it. Reveals past the cap are rejected with 429
# before any Apollo credit is spent. Example: APOLLO_MONTHLY_REVEAL_CAP=100
APOLLO_MONTHLY_REVEAL_CAP=
# Per-/discover hard ceiling on Apollo calls (APO5, exact per-call meter).
# Default 80 when unset (a typical successful discovery uses ~14). Clamped to
# [10, 200]. Tune down to cut per-discovery credit exposure, up for more reach
# on sparse/rescue cascades. Example: APOLLO_CALL_BUDGET=80
APOLLO_CALL_BUDGET=

# Mailgun — outbound email channel (Phase 2+)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Google OAuth — identity-only sign-in (Ticket 1.3) and Gmail/Calendar (Phase 2+)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Comma-separated list of email domains allowed to sign in. Default: mobupps.com
ALLOWED_LOGIN_DOMAINS=mobupps.com

# Public app URL (digest email links + OAuth). Alias: APP_PUBLIC_URL
APP_PUBLIC_URL=https://example.replit.app

# HMAC secret for signed follow-up links in digest emails
FOLLOWUP_LINK_SECRET=replace-me-with-a-long-random-string

# Follow-up digest email (SMTP — e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=followups@mobupps.com
SMTP_PASS=
FOLLOWUP_FROM=followups@mobupps.com

# In-process digest scheduler (runs hourly on API server startup)
# Set FOLLOWUP_DIGEST_SCHEDULER=false to disable
# DIGEST_SKIP_HOUR_CHECK=true sends regardless of digestHourLocal (dev only)

# Pushover — mobile follow-up reminders (optional, per-rep user keys in Accounts)
# Create an application at https://pushover.net/apps/build — paste the API token here.
# Each sales rep adds their own User Key in Accounts → Pushover mobile reminders.
PUSHOVER_APP_TOKEN=

# Pushover schedule: weekday midday batch (Mon–Fri, fixed GMT+2)
# PUSHOVER_TIMEZONE=Etc/GMT-2
# PUSHOVER_HOUR_LOCAL=12
# PUSHOVER_SKIP_SCHEDULE_CHECK=true  # dev only — send regardless of day/hour
