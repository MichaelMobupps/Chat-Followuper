# Chat Followuper — environment variables
# Copy to .env and fill values. Never commit real secrets.
# (Audit-2 B3: synced with the actual process.env census; Mailgun removed — the
#  app sends via SMTP, MAILGUN_* had zero code references.)

# ── Core ────────────────────────────────────────────────────────────────────
# Database (provisioned automatically on Replit)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Session signing (already provisioned in Replit secrets)
SESSION_SECRET=replace-me-with-a-long-random-string
# NODE_ENV=production   # cookies marked Secure + stack traces suppressed when "production"
# LOG_LEVEL=info        # pino level: trace|debug|info|warn|error

# Public base URL for OAuth redirects, digest links, and webhook callbacks.
# APP_PUBLIC_URL / PUBLIC_BASE_URL / BASE_URL are read as aliases in places.
PUBLIC_BASE_URL=https://example.replit.app
APP_PUBLIC_URL=https://example.replit.app

# ── Auth ────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Comma-separated email domains allowed to sign in. Default: mobupps.com
ALLOWED_LOGIN_DOMAINS=mobupps.com
# Comma-separated emails granted admin (/api/admin/*). UNSET = no admin access.
ADMIN_EMAILS=

# ── Anthropic (LLM generation) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Gemini API key (LLM cost reframe 2026-07): powers the default writer/lint
# models (gemini-3.5-flash). OPTIONAL — when unset, the router falls back to
# claude-sonnet-4-6 for those roles (correct but pricier). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Writer/lint model chain (per call): LLM_GEMINI_MODEL → LLM_GEMINI_FALLBACK_MODEL
# → LLM_FALLBACK_MODEL (Anthropic). Defaults:
#   gemini-3.5-flash → gemini-3-flash-preview → claude-sonnet-4-6
# NOTE (live-probed 2026-07-09): gemini-3.5-flash returns HTTP 503 (not
# provisioned) on this key's tier, so the chain currently lands writers on
# gemini-3-flash-preview ($0.50/$3.00 per MTok, verified HTTP 200). The moment
# Google serves 3.5-flash to this key, the primary takes over automatically.
# Other servable option: gemini-3.1-flash-lite ($0.25/$1.50, cheapest).
# gemini-2.5-flash / 2.5-flash-lite / 2.0-flash were RETIRED by Google mid-2026
# ("no longer available") — do not use. Add a pricing.ts entry for any new id.
# LLM_GEMINI_MODEL=gemini-3.5-flash
# LLM_GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
# Ops kill switch: set to 1 to force the all-Anthropic path (no Gemini calls).
# LLM_DISABLE_GEMINI=
# Gemini request timeout (ms, default 30000) and circuit-breaker tuning: after
# THRESHOLD consecutive infra failures (503/timeout), skip Gemini for COOLDOWN_MS.
# GEMINI_TIMEOUT_MS=30000
# LLM_GEMINI_BREAKER_THRESHOLD=3
# LLM_GEMINI_BREAKER_COOLDOWN_MS=60000
# Optional overrides for the other two chain roles (defaults are the policy).
# LLM_FALLBACK_MODEL=claude-sonnet-4-6
# LLM_CRITIC_MODEL=claude-sonnet-5
# Optional per-user daily Anthropic spend cap in USD (LLM3). Unset / <=0 disables.
# Example: LLM_DAILY_SPEND_CAP_USD=10
LLM_DAILY_SPEND_CAP_USD=
# Speed pass (2026-07-16): background finishing of manual contacts. Default ON;
# set false|0|off to disable the fire-and-forget prepare after manual-ingest
# (the zero-spend smokes do). Read per-call, no restart needed.
# BACKGROUND_PREPARE=
# Max follow-up messages the hourly pre-generation pass writes per tick
# (default 25). Excess rows are counted+logged as deferred and retry next tick.
# FOLLOWUP_PREGEN_MAX_PER_TICK=25
# Optional override of the prospector's Sonnet model id (companyResolver).
# Default claude-sonnet-4-6. (Do NOT set claude-fable-5 — see audit-2 L9.)
# PROSPECTOR_SONNET_MODEL=claude-sonnet-4-6

# ── Apollo (enrichment + phone reveal) ──────────────────────────────────────
APOLLO_API_KEY=
# Per-user monthly reveal cap (APO1/API3). Default 100. Rejected past cap (429).
APOLLO_MONTHLY_REVEAL_CAP=
# Per-/discover hard ceiling on Apollo calls (APO5). Default 80, clamped [10,200].
APOLLO_CALL_BUDGET=
# ⚠ Apollo phone-reveal WEBHOOK auth. The webhook REJECTS every reveal callback
# when NEITHER secret is set. Set at least one:
#   APOLLO_WEBHOOK_SECRET        — HMAC signing secret (preferred)
#   APOLLO_WEBHOOK_SHARED_SECRET — static bearer fallback
APOLLO_WEBHOOK_SECRET=
APOLLO_WEBHOOK_SHARED_SECRET=
# The callback URL registered with Apollo (used when requesting async reveals).
APOLLO_WEBHOOK_URL=
# Hours before a still-pending reveal is swept to "expired" (default 72).
# REVEAL_PENDING_MAX_AGE_HOURS=72

# ── Email / follow-up digests (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=followups@mobupps.com
SMTP_PASS=
FOLLOWUP_FROM=followups@mobupps.com
# HMAC secret for signed follow-up open/confirm links in digest emails.
FOLLOWUP_LINK_SECRET=replace-me-with-a-long-random-string
# Signed-link TTL in hours (API5/FUP10). Default 72.
# FOLLOWUP_LINK_TTL_HOURS=72

# ── In-process schedulers ───────────────────────────────────────────────────
# Hourly digest + pushover + weekly + nudges + reveal-sweep scheduler.
# FOLLOWUP_DIGEST_SCHEDULER=false   # disable entirely (e.g. tests)
# FOLLOWUP_DIGEST_INTERVAL_MS=3600000
# DIGEST_SKIP_HOUR_CHECK=true       # dev only — send regardless of digestHourLocal
# WEEKLY_DIGEST_SKIP_DAY_CHECK=true # dev only — send regardless of weekday
# SEND_HOUR_START / SEND_HOUR_END   # default follow-up send-window bounds (local hour)

# ── Pushover (mobile reminders) ─────────────────────────────────────────────
# Create an app at https://pushover.net/apps/build; reps add their own User Key.
PUSHOVER_APP_TOKEN=
# Weekday midday batch (Mon–Fri). Fixed GMT+2 unless overridden.
# PUSHOVER_TIMEZONE=Etc/GMT-2
# PUSHOVER_HOUR_LOCAL=12
# PUSHOVER_SKIP_SCHEDULE_CHECK=true # dev only — send regardless of day/hour
# PUSHOVER_SKIP_QUIET_HOURS=true    # dev only — bypass per-user quiet hours

# ── Dashboard build/serve (artifacts/dashboard) ─────────────────────────────
# Required only for the dev server / preview (vite build does NOT read them).
# Replit injects these at deploy time.
# PORT=5173
# BASE_PATH=/
