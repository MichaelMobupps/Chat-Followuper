{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "digest": "node --enable-source-maps ./dist/scripts/sendFollowupDigests.mjs",
    "smoke:followup": "node ../../lib/db/node_modules/tsx/dist/cli.mjs src/scripts/smokeFollowupFlow.ts",
    "smoke:audit2": "node ../../lib/db/node_modules/tsx/dist/cli.mjs src/scripts/smokeAudit2.ts",
    "smoke:bulk": "FOLLOWUP_DIGEST_SCHEDULER=false node ../../lib/db/node_modules/tsx/dist/cli.mjs src/scripts/smokeBulk.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "nodemailer": "^9.0.1",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
